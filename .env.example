# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID (use @userinfobot to find it)
CHAT_ID=your_chat_id_here

# Time to send the daily reminder in Yekaterinburg time (UTC+5), format HH:MM (default: 09:00)
REMINDER_TIME=09:00

# Text of the reminder message
REMINDER_TEXT=🔔 Ежедневное напоминание!
